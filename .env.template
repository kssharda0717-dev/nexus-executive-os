# ═══════════════════════════════════════════════════════════════
# NEXUS — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your credentials:
#   cp .env.template .env
#
# IMPORTANT: .env should be in .gitignore — NEVER commit secrets.
# ═══════════════════════════════════════════════════════════════

# ── Google Gemini AI (REQUIRED) ───────────────────────────────
# Get your key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-primary-gemini-api-key-here

# Optional: Second GCP project for HA failover (doubles your quota)
GEMINI_API_KEY_SECONDARY=

# ── Microsoft Graph / Outlook (OPTIONAL) ──────────────────────
# Register an app: https://portal.azure.com → Azure Active Directory
#   → App registrations → New registration
# Required permissions: Mail.Read, Calendars.ReadWrite, User.Read
MICROSOFT_GRAPH_CLIENT_ID=your-azure-app-client-id
MICROSOFT_GRAPH_CLIENT_SECRET=your-azure-client-secret
MICROSOFT_GRAPH_TENANT_ID=common
MICROSOFT_GRAPH_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# ── Tavily Web Search (OPTIONAL) ────────────────────────────
# Get your key: https://tavily.com → Dashboard → API Keys
# Enables: Real-time web search + LinkedIn networking agent
TAVILY_API_KEY=your-tavily-api-key-here

# ── Slack (OPTIONAL) ─────────────────────────────────────────
# Create a Slack App: https://api.slack.com/apps → Create New App
# Required scopes: chat:write, channels:read
# Enable Interactivity: Request URL → https://your-domain/mcp/slack/interactions
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_NEXUS_CHANNEL=#nexus-notifications

# ── Security (auto-generated if blank) ───────────────────────
# JWT signing secret — leave blank to auto-generate on first run
NEXUS_JWT_SECRET=
# Token expiry in minutes (default: 60)
NEXUS_JWT_EXPIRY_MINUTES=60
# Set to "true" in production (requires HTTPS)
NEXUS_SECURE_COOKIES=false

# ── Environment ──────────────────────────────────────────────
# "development" (permissive CORS, auto-login) or "production" (strict)
NEXUS_ENV=development
# Comma-separated allowed origins for production CORS
NEXUS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DATA_DIR=
